# Copie este arquivo para .env e preencha com as chaves do SEU próprio
# projeto (não use as chaves do Shoppfy original — são de outro produto).

# Crie um projeto novo em https://supabase.com/dashboard e pegue estes 3
# valores em Project Settings → API.
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Gemini (Nano Banana) — geração de foto de produto por IA. Gere sua chave
# grátis em https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Webhook da Applyfy (login automático após pagamento), se for usar o mesmo
# fluxo de venda. Token gerado ao criar o webhook em Applyfy → Integrações →
# Webhooks. Pode deixar em branco se não for usar Applyfy.
APPLYFY_WEBHOOK_TOKEN=""

# Service role key do SEU projeto Supabase — necessária pro webhook
# criar/apagar usuários via Admin API. Pegue em Project Settings → API →
# service_role. NUNCA exponha essa chave no frontend/cliente.
SUPABASE_SERVICE_ROLE_KEY=""
